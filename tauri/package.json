{
  "name": "x3fuse-tauri",
  "version": "0.1.0",
  "description": "Cross-platform X3F converter using Tauri and x3fuse-core",
  "author": "Sang Lee",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "node scripts/native-smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "tauri": "tauri",
    "pack": "tauri build --no-bundle",
    "dist": "tauri build",
    "sync:resources": "node scripts/prepare-resources.mjs",
    "dev:frontend": "vite",
    "build:frontend": "npm run build",
    "predev": "npm run sync:resources",
    "prepack": "npm run sync:resources",
    "predist": "npm run sync:resources"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "clsx": "^2.1.1",
    "i18next": "^23.16.8",
    "lucide-react": "^0.460.0",
    "react-i18next": "^15.7.4",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.2",
    "@tauri-apps/api": "^2.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "@tauri-apps/cli": "^2.10.1"
  },
  "type": "module"
}
