{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Local application windows; filesystem and subprocess work stays in Rust. The opener grant allows two URLs only: the CC BY-SA attribution link in Settings > About and the Help menu's README.",
  "windows": ["main", "settings"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color",
    "core:menu:allow-new", "core:menu:allow-popup",
    "core:image:allow-new",
    "core:resources:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/andreavolpato/spektrafilm" },
        { "url": "https://github.com/sagwaco/x3fuse#readme" }
      ]
    }
  ]
}
